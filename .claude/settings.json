{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(_context/*)",
      "Write(_context/*)",
      "Edit(_sop/*)",
      "Write(_sop/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/gabrielmangabeira/Documents/Gabriel Mangabeira/sasha-coin/.claude/hooks/secret-guard.py\""
          }
        ]
      }
    ]
  }
}